<Window x:Class="AlgorithmsLab.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlgorithmsLab.Desktop"
        Title="Лабораторная работа 4 · Сортировки" Width="1320" Height="900" MinWidth="1000" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Page}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="19,23,19,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <Path Data="M 0 12 L 0 9 M 5 12 L 5 5 M 10 12 L 10 0"
                              Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Алгоритмы" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="Лабораторная работа 4" Style="{StaticResource MutedText}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
                    <Button x:Name="ThemeButton" Click="ToggleTheme" AutomationProperties.Name="Переключить тему">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
                            <TextBlock x:Name="ThemeLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,43,0,0">
                    <TextBlock Text="Задания" Style="{StaticResource Label}" Margin="11,0,0,10" />
                    <RadioButton x:Name="ArraysNav" Tag="01" Content="Массивы" Style="{StaticResource Nav}" Checked="Navigate" />
                    <RadioButton x:Name="TablesNav" Tag="02" Content="Таблицы из файла" Style="{StaticResource Nav}" Checked="Navigate" />
                    <RadioButton x:Name="WordsNav" Tag="03" Content="Слова в тексте" Style="{StaticResource Nav}" Checked="Navigate" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" x:Name="WorkspaceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,25,30,30" MaxWidth="1430">
                <local:ArrayView x:Name="Arrays" />
                <local:ExternalView x:Name="Tables" Visibility="Collapsed" />
                <local:WordView x:Name="Words" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
